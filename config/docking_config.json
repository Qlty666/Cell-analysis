{
  "name": "liver_cancer_vs",
  "workdir": "../dock",
  "output_dir": "outputs/run_001",
  "receptor": {
    "input": "data/receptors/receptor.pdb",
    "output": "data/receptors/receptor.pdbqt",
    "center": [0.0, 0.0, 0.0],
    "size": [22.5, 22.5, 22.5],
    "flexible": []
  },
  "ligand": {
    "input": "data/ligands/library.sdf",
    "output_dir": "data/ligands/prepared",
    "smiles_column": "SMILES",
    "id_column": "ID",
    "ph": 7.4,
    "remove_salts": true,
    "neutralize": true,
    "max_heavy_atoms": 60,
    "max_rotatable_bonds": 15,
    "max_ligands": null,
    "conformers": 1,
    "seed": 42,
    "engine": "auto"
  },
  "docking": {
    "engine": "vina",
    "executable": "vina",
    "scoring": "vina",
    "exhaustiveness": 8,
    "num_modes": 9,
    "energy_range": 3.0,
    "cpu": 4,
    "max_workers": 4,
    "seed": 42,
    "timeout_seconds": 600,
    "resume": true
  },
  "analysis": {
    "cutoff": -7.0,
    "top_n": 100,
    "figures": true,
    "diversity": true,
    "tanimoto_cutoff": 0.7
  },
  "knockout": {
    "enabled": true,
    "expression_csv": "data/knockout/expression.csv",
    "metadata_csv": null,
    "ppi_network_csv": null,
    "depmap_csv": null,
    "prognosis_csv": null,
    "druggability_csv": null,
    "off_target_csv": null,
    "group_column": "condition",
    "cell_type_column": null,
    "case_label": null,
    "normal_label": null,
    "top_n": 50,
    "figures": true,
    "max_genes": 2000,
    "max_samples": 5000,
    "corr_cutoff": 0.7,
    "liver_lineage": "liver",
    "off_target_penalty": 0.05,
    "disease_up_genes": null,
    "disease_down_genes": null,
    "pathway_genes": null,
    "weights": {
      "expression": 0.35,
      "proliferation": 0.25,
      "network": 0.20,
      "depmap": 0.20
    },
    "target_weights": {
      "base": 0.35,
      "reversal": 0.20,
      "pathway": 0.15,
      "specificity": 0.10,
      "prognosis": 0.10,
      "druggability": 0.10,
      "ppi_hub": 0.10
    }
  },
  "network_toxicology": {
    "compound_name": null,
    "disease_name": null,
    "compound_targets_csv": null,
    "target_sources": null,
    "disease_genes_csv": null,
    "disease_gene_column": null,
    "ppi_network_csv": null,
    "output_dir": "outputs/run_001/network_toxicology",
    "venn": true
  },
  "faers": {
    "input_csv": null,
    "drug_column": "drug",
    "event_column": "event",
    "count_column": null,
    "min_count": 3,
    "output_dir": "outputs/run_001/faers"
  },
  "validation": {
    "top_n": 10,
    "output_dir": "outputs/run_001/validation"
  }
}
