{
  "name": "Liver Cancer Bioinformatics Workflow",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip",
  "postStartCommand": "bash .devcontainer/start-web-ui.sh",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Liver Cancer Web UI",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteUser": "vscode"
}
